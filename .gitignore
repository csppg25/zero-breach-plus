# Personal scan output — contains usernames, account names, timestamps, hits.
# Never publish. Users' own reports stay on their own machines.
findings/
*.report.txt
scan-*.txt
scan-*.json

# The website self-check is deployed separately and is a different work stream;
# its NOTES.md also carries infrastructure detail that must not be published.
web/

# Python caches and build junk
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.DS_Store

# The single-file build and its emitted feeds are release artifacts,
# regenerated by build/build.py. Keep the whole dist/ out of source control so
# the source is the source of truth, and no locally generated SHA256SUMS.txt or
# scan output is ever published by accident.
zero-breach.py
/dist/


# Internal development/process docs — kept locally, not published.
HANDOVER.md
DESIGN.md
SPEC-scanner.md
REVIEW-*.md
RELEASE-CANDIDATE-*.md

